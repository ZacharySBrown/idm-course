build/audio/narration/
build/audio/stemforge-renders/
build/glossary.md
build/ableton-devices/audio/narration/
build/ableton-devices/audio/stemforge-renders/

# Local + Python noise
node_modules/
.venv/
__pycache__/
*.pyc
.DS_Store

# PDFs fetched from external sources (licensed content — cite, don't mirror)
courses/*/references/pdfs/*.pdf
courses/*/references/pdfs/*.html
courses/*/references/pdfs/max_for_live_readmes/
courses/*/references/transcripts/*.md
!courses/*/references/transcripts/README.md

# Local screenshot inbox
_screenshots-inbox/

# Committed to repo:
#   courses/<id>/lessons|episodes/   — all source content
#   courses/<id>/references/         — glossary.json, bibliography.json, songs.json, images.json
#   shared/style/                    — base voice + lexicon
#   shared/tools/                    — cross-course build pipeline
#   build/audio/episodes/            — 12 IDM MP3 podcast episodes (~434 MB)
#   build/html/                      — 12 rendered HTML decks + index + glossary
#   build/pdf/idm_glossary.pdf       — reMarkable-ready glossary
#   build/diagram_sanity.*           — QA reports
#   build/images_fetch_status.json
#   podcast.xml + artwork.jpg        — load-bearing published podcast feed
